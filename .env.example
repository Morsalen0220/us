# Server configuration (BHPanel automatically injects SOCKET; local dev uses PORT)
PORT=3000
# SOCKET=/run/bhpanel/app.sock
NODE_ENV=production

# Optional persistent directories outside app folder (recommended on BHPanel "Install and build")
# DATA_DIR=/home/username/techhaven-storage/data
# UPLOAD_DIR=/home/username/techhaven-storage/uploads

# Public canonical domain (no trailing slash)
SITE_URL=https://techhavenus.com

# Session signing secret (set a strong random string in production)
SESSION_SECRET=change-this-to-a-64-char-random-secret

# Initial admin account (used when database is first seeded)
ADMIN_EMAIL=admin@techhavenus.com
ADMIN_PASSWORD=TechHaven@2026!
