<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <header style="margin-bottom:1.5rem;">
    <h1 style="margin:0 0 0.75rem;font-size:1.9rem;font-weight:850;">Search TechHaven</h1>
    <form action="/search" method="GET" class="search-form-row" style="max-width:640px;">
      <input type="search" name="q" value="<%= q %>" class="search-input" placeholder="Search GTA 6, AI agents, GPU benchmarks, tutorials..." required>
      <button type="submit" class="btn-primary">Search</button>
    </form>
  </header>

  <div class="layout-split">
    <div>
      <% if (q) { %>
      <p style="margin:0 0 1.1rem;color:var(--text-muted);">Found <strong><%= posts.length %></strong> result<%= posts.length === 1 ? '' : 's' %> for “<strong><%= q %></strong>”.</p>
      <% } %>

      <% if (posts.length === 0 && q) { %>
      <div class="page-card" style="padding:1.5rem;">
        <p style="margin:0;">No articles matched that query. Try broader keywords like <strong>GTA</strong>, <strong>AI</strong>, <strong>GPUs</strong>, or <strong>Core Web Vitals</strong>.</p>
      </div>
      <% } else { %>
      <div class="posts-grid two-col">
        <% posts.forEach(function(post) { %>
        <article class="post-card">
          <% if (post.featured_image_thumb || post.featured_image) { %>
          <a href="/article/<%= post.slug %>" class="post-card-img">
            <img src="<%= post.featured_image_thumb || post.featured_image %>" alt="<%= post.featured_image_alt || post.title %>" width="640" height="360" loading="lazy">
          </a>
          <% } %>
          <div class="post-card-body">
            <% if (post.category_name) { %>
            <div><a href="/category/<%= post.category_slug %>" class="cat-pill" style="--cat-color:<%= post.category_color || '#2563EB' %>"><%= post.category_name %></a></div>
            <% } %>
            <h2 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h2>
            <p class="post-card-excerpt"><%= post.excerpt %></p>
            <div class="meta-line">
              <time datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
              <span>•</span>
              <span><%= post.reading_time %> min</span>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </div>

    <%- include('../partials/sidebar') %>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
