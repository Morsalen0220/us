<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/ai-tools">AI Tools Directory</a>
    <span>/</span>
    <span><%= tool.name %></span>
  </nav>

  <div class="layout-split">
    <article class="page-card" style="margin:0;">
      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.1rem;">
        <% if (tool.image_url) { %>
        <img src="<%= assetUrl(tool.image_url) %>" alt="<%= tool.name %>" class="tool-logo" style="width:64px;height:64px;object-fit:cover;padding:0;border-radius:14px;border:1px solid var(--border);">
        <% } else { %>
        <div class="tool-logo" style="width:56px;height:56px;font-size:1.4rem;background:<%= tool.logo_color %>"><%= tool.name.slice(0, 1) %></div>
        <% } %>
        <div style="min-width:0;flex:1;">
          <span class="cat-pill" style="--cat-color:<%= tool.logo_color %>"><%= tool.category %></span>
          <h1 style="margin:0.35rem 0 0.15rem;font-size:clamp(1.45rem,3vw,1.85rem);"><%= tool.name %></h1>
          <div style="font-size:0.9rem;color:var(--text-soft);">Pricing: <strong><%= tool.price_label %></strong> (<%= tool.pricing_model %>) • Rating: <strong><%- icon('star', 14) %> <%= tool.rating %>/5</strong></div>
        </div>
      </div>

      <% if (tool.tagline) { %>
      <p style="font-size:1.08rem;font-weight:650;color:var(--text);margin:0 0 0.85rem;"><%= tool.tagline %></p>
      <% } %>

      <div style="font-size:1rem;line-height:1.75;color:var(--text-content, var(--text));margin-bottom:1.25rem;">
        <% String(tool.description || '').split(/\r?\n\r?\n/).map(function(p){ return p.trim(); }).filter(Boolean).forEach(function(para) { %>
        <p style="margin:0 0 0.85rem;"><%= para %></p>
        <% }) %>
      </div>

      <div class="pros-cons-grid">
        <div style="background:#f0fdf4;border:1px solid #86efac;border-radius:12px;padding:1rem;color:#14532d;">
          <h3 style="margin:0 0 0.5rem;display:flex;align-items:center;gap:0.4rem;"><%- icon('check-circle', 18) %> Pros</h3>
          <ul style="margin:0;padding-left:1.2rem;">
            <% tool.pros.forEach(function(p) { %><li><%= p %></li><% }) %>
          </ul>
        </div>
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:1rem;color:#7f1d1d;">
          <h3 style="margin:0 0 0.5rem;display:flex;align-items:center;gap:0.4rem;"><%- icon('alert-triangle', 18) %> Cons</h3>
          <ul style="margin:0;padding-left:1.2rem;">
            <% tool.cons.forEach(function(c) { %><li><%= c %></li><% }) %>
          </ul>
        </div>
      </div>

      <% if (tool.website_url) { %>
      <a href="<%= tool.website_url %>" target="_blank" rel="noopener noreferrer nofollow" class="btn-primary">Visit Official Website ↗</a>
      <% } %>
    </article>

    <%- include('../partials/sidebar') %>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
