<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <span>Region: <%= regionInfo.name %></span>
  </nav>

  <header style="margin-bottom:1.75rem;padding-bottom:1.1rem;border-bottom:2px solid var(--border);">
    <div class="region-pills" style="margin-bottom:0.75rem;">
      <a href="/region/usa" class="region-pill <%= regionKey === 'usa' ? 'active' : '' %>"><%- icon('map-pin', 14) %> USA</a>
      <a href="/region/europe" class="region-pill <%= regionKey === 'europe' ? 'active' : '' %>"><%- icon('map-pin', 14) %> Europe</a>
      <a href="/region/usa-europe" class="region-pill <%= regionKey === 'usa-europe' ? 'active' : '' %>"><%- icon('globe', 14) %> USA &amp; Europe</a>
      <a href="/region/global" class="region-pill <%= regionKey === 'global' ? 'active' : '' %>"><%- icon('globe', 14) %> Global</a>
    </div>
    <h1 style="margin:0.35rem 0;font-size:2rem;font-weight:850;"><%= regionInfo.name %></h1>
    <p style="margin:0;color:var(--text-muted);max-width:72ch;"><%= regionInfo.description %></p>
  </header>

  <div class="layout-split">
    <div class="posts-grid two-col">
      <% posts.forEach(function(post) { %>
      <article class="post-card">
        <% if (post.featured_image_thumb || post.featured_image) { %>
        <a href="/article/<%= post.slug %>" class="post-card-img">
          <img src="<%= assetUrl(post.featured_image_thumb || post.featured_image) %>" alt="<%= post.featured_image_alt || post.title %>" width="640" height="360" loading="lazy">
        </a>
        <% } %>
        <div class="post-card-body">
          <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
            <% if (post.category_name) { %>
            <a href="/category/<%= post.category_slug %>" class="cat-pill" style="--cat-color:<%= post.category_color || '#2563EB' %>"><%= post.category_name %></a>
            <% } %>
            <span class="region-badge"><%= post.region %></span>
          </div>
          <h2 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h2>
          <p class="post-card-excerpt"><%= post.excerpt %></p>
          <div class="meta-line">
            <time datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
            <span>•</span>
            <span><%= post.reading_time %> min</span>
          </div>
        </div>
      </article>
      <% }) %>
    </div>

    <%- include('../partials/sidebar') %>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
