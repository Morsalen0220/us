<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/timelines">Timelines</a>
    <span>/</span>
    <span><%= timeline.title %></span>
  </nav>

  <header style="margin-bottom:1.5rem;">
    <h1 style="margin:0.5rem 0 0.4rem;font-size:2rem;font-weight:850;"><%= timeline.title %></h1>
    <p style="margin:0;color:var(--text-muted);max-width:72ch;"><%= timeline.description %></p>
  </header>

  <div class="layout-split">
    <div class="timeline-track">
      <% events.forEach(function(ev) { %>
      <article class="timeline-node">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
          <strong style="color:var(--accent);font-size:0.86rem;"><%= ev.event_date %></strong>
          <% if (ev.is_major) { %><span class="cat-pill" style="--cat-color:#DC2626">Major Milestone</span><% } %>
        </div>
        <h2 style="margin:0 0 0.35rem;font-size:1.12rem;"><%= ev.headline %></h2>
        <p style="margin:0 0 0.65rem;color:var(--text-muted);font-size:0.94rem;"><%= ev.summary %></p>
        <div style="display:flex;gap:0.85rem;font-size:0.84rem;font-weight:600;">
          <% if (ev.post_slug) { %><a href="/article/<%= ev.post_slug %>" style="color:var(--accent);">Read Full Story &rarr;</a><% } %>
          <% if (ev.source_url) { %><a href="<%= ev.source_url %>" target="_blank" rel="noopener noreferrer nofollow" style="color:var(--text-soft);">Official Source ↗</a><% } %>
        </div>
      </article>
      <% }) %>
    </div>

    <%- include('../partials/sidebar') %>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
