<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <div class="page-card" style="max-width:680px;text-align:center;padding:3rem 1.75rem;">
    <div style="margin-bottom:0.65rem;color:var(--accent);">
      <%- mode === 'confirmed' ? icon('check-circle', 44) : mode === 'unsubscribed' ? icon('bell-off', 44) : icon('alert-triangle', 44) %>
    </div>
    <h1 style="margin:0 0 0.65rem;"><%= heading %></h1>
    <p style="color:var(--text-muted);font-size:1.02rem;line-height:1.6;margin:0 auto 1.5rem;max-width:52ch;"><%= message %></p>

    <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
      <a href="/" class="btn-primary">Return to Homepage</a>
      <% if (unsubscribeUrl) { %>
      <a href="<%= unsubscribeUrl %>" class="icon-btn">Unsubscribe Anytime</a>
      <% } %>
    </div>

    <div style="margin-top:2rem;padding-top:1.1rem;border-top:1px solid var(--border);font-size:0.8rem;color:var(--text-soft);">
      <%= settings.publisher_legal_name || 'TechHaven US' %> •
      <%= [settings.publisher_street_address, settings.publisher_city || 'New York', [settings.publisher_state || 'NY', settings.publisher_postal_code].filter(Boolean).join(' '), settings.publisher_country || 'United States'].filter(Boolean).join(', ') %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
