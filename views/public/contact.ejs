<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <div class="page-card">
    <h1 style="margin-top:0;">Contact TechHaven US</h1>
    <p style="color:var(--text-muted);margin-bottom:1.15rem;">
      Have a question, feedback, article correction, topic suggestion, or partnership inquiry? Reach our team directly at
      <a href="mailto:<%= settings.contact_email || 'contact@techhavenus.com' %>" style="color:var(--accent);font-weight:600;"><%= settings.contact_email || 'contact@techhavenus.com' %></a> or send a message using the form below. We typically respond within 1–2 business days.
    </p>

    <div style="background:var(--surface-alt);border:1px solid var(--border);border-radius:12px;padding:1rem 1.2rem;margin-bottom:1.5rem;font-size:0.9rem;">
      <div style="font-weight:800;margin-bottom:0.35rem;">Contact Information</div>
      <div><strong><%= settings.publisher_legal_name || 'TechHaven US' %></strong> • <%= settings.publisher_owner_name || 'Md Apple Mahmud' %></div>
      <div>Location: <%= [settings.publisher_street_address, settings.publisher_city || 'New York', [settings.publisher_state || 'NY', settings.publisher_postal_code].filter(Boolean).join(' '), settings.publisher_country || 'United States'].filter(Boolean).join(', ') %></div>
      <div style="margin-top:0.3rem;">
        General: <a href="mailto:<%= settings.contact_email || 'contact@techhavenus.com' %>" style="color:var(--accent);"><%= settings.contact_email || 'contact@techhavenus.com' %></a> •
        Editorial: <a href="mailto:editorial@techhavenus.com" style="color:var(--accent);">editorial@techhavenus.com</a> •
        Privacy / GDPR: <a href="mailto:<%= settings.privacy_email || 'privacy@techhavenus.com' %>" style="color:var(--accent);"><%= settings.privacy_email || 'privacy@techhavenus.com' %></a>
        <% if (settings.publisher_phone) { %> • Phone: <%= settings.publisher_phone %><% } %>
      </div>
    </div>

    <% if (status === 'success') { %>
    <div class="alert alert-success">Thank you! Your message has been received by the TechHaven US team.</div>
    <% } else if (status === 'error' && errorMsg) { %>
    <div class="alert alert-error"><%= errorMsg %></div>
    <% } %>

    <form action="/contact" method="POST" class="form-grid">
      <div style="display:none;"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>

      <div class="form-field">
        <label for="contactName">Your Name</label>
        <input id="contactName" type="text" name="name" value="<%= formValues.name || '' %>" required placeholder="Jane Doe">
      </div>

      <div class="form-field">
        <label for="contactEmail">Email Address</label>
        <input id="contactEmail" type="email" name="email" value="<%= formValues.email || '' %>" required placeholder="jane@example.com">
      </div>

      <div class="form-field">
        <label for="contactSubject">Subject</label>
        <input id="contactSubject" type="text" name="subject" value="<%= formValues.subject || '' %>" placeholder="Feedback / Correction / Partnership / General Inquiry">
      </div>

      <div class="form-field">
        <label for="contactMessage">Message</label>
        <textarea id="contactMessage" name="message" rows="6" required placeholder="Share full details, links, or feedback..."><%= formValues.message || '' %></textarea>
      </div>

      <div>
        <button type="submit" class="btn-primary">Send Message</button>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
