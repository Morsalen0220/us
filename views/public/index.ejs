<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <!-- Featured Hero Grid -->
  <% if (featuredPosts && featuredPosts.length > 0) { const lead = featuredPosts[0]; const sideFeatured = featuredPosts.slice(1, 4); %>
  <section aria-label="Featured Tech Stories" class="hero-grid">
    <article class="hero-lead">
      <% if (lead.featured_image) { %>
      <a href="/article/<%= lead.slug %>" class="hero-lead-media">
        <img
          src="<%= assetUrl(lead.featured_image) %>"
          <% if (lead.featured_image_thumb) { %>srcset="<%= assetUrl(lead.featured_image_thumb) %> 640w, <%= assetUrl(lead.featured_image) %> 1400w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 66vw, 760px"<% } %>
          alt="<%= lead.featured_image_alt || lead.title %>"
          title="<%= lead.featured_image_title || lead.title %>"
          width="<%= lead.featured_image_width || 1400 %>"
          height="<%= lead.featured_image_height || 788 %>"
          fetchpriority="high"
          decoding="async"
        >
      </a>
      <% } %>
      <div class="hero-lead-body">
        <div style="display:flex;gap:0.45rem;align-items:center;flex-wrap:wrap;">
          <% if (lead.category_name) { %>
          <a href="/category/<%= lead.category_slug %>" class="cat-pill" style="--cat-color:<%= lead.category_color || '#2563EB' %>"><%= lead.category_name %></a>
          <% } %>
        </div>
        <h1 class="hero-lead-title"><a href="/article/<%= lead.slug %>"><%= lead.title %></a></h1>
        <p class="hero-lead-excerpt"><%= lead.excerpt %></p>
        <div class="meta-line">
          <span>By <strong><%= lead.author_name || 'TechHaven Editorial' %></strong></span>
          <span>•</span>
          <time datetime="<%= lead.published_at %>"><%= formatDate(lead.published_at) %></time>
          <span>•</span>
          <span><%= lead.reading_time %> min read</span>
        </div>
      </div>
    </article>

    <div class="hero-side-stack">
      <% sideFeatured.forEach(function(item) { %>
      <article class="hero-mini-card">
        <% if (item.featured_image_thumb || item.featured_image) { %>
        <a href="/article/<%= item.slug %>" class="hero-mini-thumb">
          <img
            src="<%= assetUrl(item.featured_image_thumb || item.featured_image) %>"
            alt="<%= item.featured_image_alt || item.title %>"
            title="<%= item.featured_image_title || item.title %>"
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
          >
        </a>
        <% } %>
        <div>
          <% if (item.category_name) { %>
          <a href="/category/<%= item.category_slug %>" class="cat-pill" style="--cat-color:<%= item.category_color || '#2563EB' %>"><%= item.category_name %></a>
          <% } %>
          <h2 class="hero-mini-title"><a href="/article/<%= item.slug %>"><%= item.title %></a></h2>
          <div class="meta-line">
            <time datetime="<%= item.published_at %>"><%= formatDate(item.published_at) %></time>
            <span>•</span>
            <span><%= item.reading_time %> min</span>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- 1. Trending Now Strip (5-8 Popular Articles) -->
  <% if (trendingPosts && trendingPosts.length > 0) { %>
  <section style="margin-bottom:2rem;" aria-label="Trending Now">
    <div class="section-header">
      <h2 class="section-title"><%- icon('flame', 20) %> Trending Now</h2>
      <span style="font-size:0.84rem;color:var(--text-soft);">Most read stories right now</span>
    </div>
    <div class="trending-grid">
      <% trendingPosts.slice(0, 6).forEach(function(tp) { %>
      <article class="trending-row-card">
        <% if (tp.featured_image_thumb || tp.featured_image) { %>
        <a href="/article/<%= tp.slug %>" class="trending-row-thumb">
          <img src="<%= assetUrl(tp.featured_image_thumb || tp.featured_image) %>" alt="<%= tp.featured_image_alt || tp.title %>" width="108" height="74" loading="lazy" decoding="async">
        </a>
        <% } %>
        <div class="trending-row-body">
          <h3 class="trending-row-title"><a href="/article/<%= tp.slug %>"><%= tp.title %></a></h3>
          <div class="meta-line">
            <span><%= tp.category_name || 'Tech' %></span>
            <span>•</span>
            <time datetime="<%= tp.published_at %>"><%= formatDate(tp.published_at) %></time>
            <span>•</span>
            <span><%= tp.reading_time %> min read</span>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- 2. AI Today Section + Daily AI Briefing Link -->
  <section class="ai-today-band" aria-label="AI Today">
    <div class="section-header" style="border-bottom-color:color-mix(in srgb, var(--accent) 25%, var(--border));">
      <div>
        <h2 class="section-title"><%- icon('bot', 20) %> AI Today</h2>
        <div style="font-size:0.86rem;color:var(--text-muted);">AI News, ChatGPT, Gemini, Claude, AI Agents &amp; Tested AI Tools</div>
      </div>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
        <a href="/briefing" class="section-more">Daily AI Briefing &rarr;</a>
        <a href="/category/ai" class="section-more">All AI News &rarr;</a>
      </div>
    </div>

    <% if (latestBriefing) { %>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:0.95rem 1.1rem;margin-bottom:1.1rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
      <div>
        <span class="badge badge-webp" style="background:var(--accent-soft);color:var(--accent);padding:0.15rem 0.5rem;border-radius:999px;font-size:0.72rem;font-weight:800;">LATEST BRIEF &bull; <%= latestBriefing.pretty_date || formatDate(latestBriefing.briefing_date) %></span>
        <strong style="margin-left:0.45rem;"><%= latestBriefing.title %></strong>
        <div style="font-size:0.84rem;color:var(--text-muted);margin-top:0.2rem;"><%= latestBriefing.summary %></div>
      </div>
      <a href="/briefing" class="btn-primary">Read 2-Min Brief</a>
    </div>
    <% } %>

    <div class="posts-grid">
      <% aiTodayPosts.slice(0, 3).forEach(function(post) { %>
      <article class="post-card">
        <% if (post.featured_image_thumb || post.featured_image) { %>
        <a href="/article/<%= post.slug %>" class="post-card-img">
          <img src="<%= assetUrl(post.featured_image_thumb || post.featured_image) %>" alt="<%= post.featured_image_alt || post.title %>" width="640" height="360" loading="lazy" decoding="async">
        </a>
        <% } %>
        <div class="post-card-body">
          <h3 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h3>
          <p class="post-card-excerpt"><%= post.excerpt %></p>
          <div class="meta-line">
            <time datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
            <span>•</span>
            <span><%= post.reading_time %> min</span>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </section>

  <!-- Main Two-Column Feed + Sidebar -->
  <div class="layout-split">
    <div>
      <!-- 3. Editor's Picks -->
      <% if (editorsPicks && editorsPicks.length > 0) { %>
      <section style="margin-bottom:2.25rem;" aria-label="Editor's Picks">
        <div class="section-header">
          <h2 class="section-title"><%- icon('star', 20) %> Editor’s Picks</h2>
          <span style="font-size:0.84rem;color:var(--text-soft);">Essential tech &amp; gaming deep dives</span>
        </div>
        <div class="posts-grid two-col">
          <% editorsPicks.slice(0, 4).forEach(function(post) { %>
          <article class="post-card">
            <% if (post.featured_image_thumb || post.featured_image) { %>
            <a href="/article/<%= post.slug %>" class="post-card-img">
              <img src="<%= assetUrl(post.featured_image_thumb || post.featured_image) %>" alt="<%= post.featured_image_alt || post.title %>" width="640" height="360" loading="lazy" decoding="async">
            </a>
            <% } %>
            <div class="post-card-body">
              <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                <% if (post.category_name) { %>
                <a href="/category/<%= post.category_slug %>" class="cat-pill" style="--cat-color:<%= post.category_color || '#2563EB' %>"><%= post.category_name %></a>
                <% } %>
              </div>
              <h3 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="post-card-excerpt"><%= post.excerpt %></p>
              <div class="meta-line">
                <span><%= post.author_name || 'TechHaven' %></span>
                <span>•</span>
                <span><%= post.reading_time %> min</span>
              </div>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- Latest Stories + In-Feed Ad -->
      <section aria-label="Latest Stories">
        <div class="section-header">
          <h2 class="section-title"><%- icon('newspaper', 20) %> Latest Stories</h2>
          <span style="font-size:0.84rem;color:var(--text-soft);"><%= pagination.totalPosts %> published articles</span>
        </div>

        <div class="posts-grid two-col">
          <% latestPosts.forEach(function(post, idx) { %>
          <article class="post-card">
            <% if (post.featured_image_thumb || post.featured_image) { %>
            <a href="/article/<%= post.slug %>" class="post-card-img">
              <img
                src="<%= assetUrl(post.featured_image_thumb || post.featured_image) %>"
                alt="<%= post.featured_image_alt || post.title %>"
                title="<%= post.featured_image_title || post.title %>"
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
              >
            </a>
            <% } %>
            <div class="post-card-body">
              <div style="display:flex;gap:0.4rem;flex-wrap:wrap;align-items:center;">
                <% if (post.category_name) { %>
                <a href="/category/<%= post.category_slug %>" class="cat-pill" style="--cat-color:<%= post.category_color || '#2563EB' %>"><%= post.category_name %></a>
                <% } %>
              </div>
              <h3 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="post-card-excerpt"><%= post.excerpt %></p>
              <div class="meta-line">
                <span><%= post.author_name || 'TechHaven' %></span>
                <span>•</span>
                <time datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
                <span>•</span>
                <span><%= post.reading_time %> min</span>
              </div>
            </div>
          </article>
          <% if (idx === 3) { %>
          <div style="grid-column: 1 / -1;">
            <%- renderAd('ads_slot_infeed', 'ad-slot-infeed') %>
          </div>
          <% } %>
          <% }) %>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <nav class="pagination" aria-label="Pagination">
          <% if (pagination.page > 1) { %>
          <a href="/?page=<%= pagination.page - 1 %>" class="page-btn">&larr; Newer</a>
          <% } %>
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
          <a href="/?page=<%= p %>" class="page-btn <%= p === pagination.page ? 'active' : '' %>"><%= p %></a>
          <% } %>
          <% if (pagination.page < pagination.totalPages) { %>
          <a href="/?page=<%= pagination.page + 1 %>" class="page-btn">Older &rarr;</a>
          <% } %>
        </nav>
        <% } %>
      </section>

      <!-- 4. Reviews & Comparisons -->
      <% if (reviewsPosts && reviewsPosts.length > 0) { %>
      <section style="margin-top:2.25rem;" aria-label="Reviews & Comparisons">
        <div class="section-header">
          <h2 class="section-title"><%- icon('scale', 20) %> Reviews &amp; Comparisons</h2>
          <a href="/category/reviews-comparisons" class="section-more">All Reviews &rarr;</a>
        </div>
        <div class="posts-grid">
          <% reviewsPosts.forEach(function(post) { %>
          <article class="post-card">
            <% if (post.featured_image_thumb || post.featured_image) { %>
            <a href="/article/<%= post.slug %>" class="post-card-img">
              <img src="<%= assetUrl(post.featured_image_thumb || post.featured_image) %>" alt="<%= post.featured_image_alt || post.title %>" width="640" height="360" loading="lazy" decoding="async">
            </a>
            <% } %>
            <div class="post-card-body">
              <h3 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="post-card-excerpt"><%= post.excerpt %></p>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- 5. How-To Guides -->
      <% if (howToGuides && howToGuides.length > 0) { %>
      <section style="margin-top:2.25rem;" aria-label="How-To Guides">
        <div class="section-header">
          <h2 class="section-title"><%- icon('wrench', 20) %> How-To &amp; Practical Guides</h2>
          <a href="/category/how-to" class="section-more">All Guides &rarr;</a>
        </div>
        <div class="posts-grid">
          <% howToGuides.forEach(function(post) { %>
          <article class="post-card">
            <% if (post.featured_image_thumb || post.featured_image) { %>
            <a href="/article/<%= post.slug %>" class="post-card-img">
              <img src="<%= assetUrl(post.featured_image_thumb || post.featured_image) %>" alt="<%= post.featured_image_alt || post.title %>" width="640" height="360" loading="lazy" decoding="async">
            </a>
            <% } %>
            <div class="post-card-body">
              <h3 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="post-card-excerpt"><%= post.excerpt %></p>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
      <% } %>

      <% if (typeof videoPosts !== 'undefined' && videoPosts && videoPosts.length > 0) { %>
      <section style="margin-top:2.2rem;padding-top:1.5rem;border-top:2px solid var(--border);">
        <div class="section-header" style="display:flex;justify-content:space-between;align-items:center;gap:0.75rem;flex-wrap:wrap;">
          <h2 class="section-title"><%- icon('clapperboard', 20) %> Video Reviews &amp; YouTube Shorts</h2>
          <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
            <button type="button" id="pushBannerBtn" class="btn btn-outline btn-sm" style="white-space:nowrap;"><span class="btn-ico"><%- icon('bell', 15) %></span><span class="btn-label">Enable Breaking Alerts</span></button>
            <a href="/videos" style="font-size:0.84rem;font-weight:700;">All Videos →</a>
          </div>
        </div>
        <div class="video-hub-grid">
          <% videoPosts.forEach(function(vp) { %>
          <article class="post-card" style="display:flex;flex-direction:column;">
            <div class="yt-lite <%= (vp.videoInfo.isShort || vp.video_is_short) ? 'yt-lite-short' : '' %>" data-yt-id="<%= vp.videoInfo.videoId %>" data-yt-title="<%= vp.video_title || vp.title %>" data-yt-short="<%= (vp.videoInfo.isShort || vp.video_is_short) ? '1' : '0' %>" style="margin:0;border-radius:var(--radius) var(--radius) 0 0;">
              <img src="<%= vp.videoInfo.thumbnailUrl %>" alt="<%= vp.video_title || vp.title %>" loading="lazy" decoding="async">
              <button type="button" class="yt-play-btn" aria-label="Play YouTube Video: <%= vp.video_title || vp.title %>"><%- icon('play', 22) %></button>
              <span class="yt-badge"><%= (vp.videoInfo.isShort || vp.video_is_short) ? 'SHORTS' : (vp.video_duration || 'VIDEO') %></span>
            </div>
            <div class="post-card-body">
              <div class="post-card-meta">
                <span><%= vp.category_name || 'Video' %></span>
                <span>•</span>
                <time datetime="<%= vp.published_at %>"><%= formatDate(vp.published_at) %></time>
              </div>
              <h3 class="post-card-title"><a href="/article/<%= vp.slug %>"><%= vp.video_title || vp.title %></a></h3>
              <p class="post-card-excerpt"><%= vp.excerpt %></p>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
      <% } %>
    </div>

    <%- include('../partials/sidebar') %>
  </div>

  <!-- 6. Weekly Tech Digest Newsletter Banner -->
  <section class="digest-banner" aria-label="Weekly Tech Digest">
    <div>
      <span class="cat-pill" style="--cat-color:#1d4ed8">Weekly Tech Digest</span>
      <h2 style="margin:0.55rem 0 0;font-size:1.55rem;color:#fff;">Get the Friday Tech &amp; AI Dispatch</h2>
      <p>One crisp weekly email summarizing major AI model drops, GTA 5/6 updates, cybersecurity advisories, and practical tutorials.</p>
    </div>
    <form class="digest-form js-newsletter-form" data-source="weekly-digest">
      <input type="email" name="email" placeholder="Enter your work or personal email..." required aria-label="Weekly Tech Digest Email">
      <button type="submit" class="btn-primary">Join Weekly Digest</button>
      <label style="width:100%;display:flex;gap:0.45rem;align-items:center;font-size:0.76rem;color:#cbd5e1;cursor:pointer;">
        <input type="checkbox" name="gdpr_consent" value="1" required>
        <span>GDPR &amp; CAN-SPAM consent: send me confirmation via double opt-in (unsubscribe in 1 click anytime).</span>
      </label>
      <div class="newsletter-msg" style="width:100%;" aria-live="polite"></div>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
