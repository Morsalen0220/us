<!DOCTYPE html>
<html lang="en-US">
<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>

<main class="main-content container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <span>Tag: #<%= tag.name %></span>
  </nav>

  <header style="margin-bottom:1.75rem;padding-bottom:1rem;border-bottom:2px solid var(--border);">
    <span class="cat-pill" style="--cat-color:#2563EB">Topic Tag</span>
    <h1 style="margin:0.5rem 0 0.3rem;font-size:2rem;font-weight:850;">#<%= tag.name %></h1>
    <p style="margin:0;color:var(--text-muted);"><%= posts.length %> matching article<%= posts.length === 1 ? '' : 's' %> in our coverage.</p>
  </header>

  <div class="layout-split">
    <div class="posts-grid two-col">
      <% posts.forEach(function(post) { %>
      <article class="post-card">
        <% if (post.featured_image_thumb || post.featured_image) { %>
        <a href="/article/<%= post.slug %>" class="post-card-img">
          <img
            src="<%= post.featured_image_thumb || post.featured_image %>"
            alt="<%= post.featured_image_alt || post.title %>"
            title="<%= post.featured_image_title || post.title %>"
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
          >
        </a>
        <% } %>
        <div class="post-card-body">
          <% if (post.category_name) { %>
          <div><a href="/category/<%= post.category_slug %>" class="cat-pill" style="--cat-color:<%= post.category_color || '#2563EB' %>"><%= post.category_name %></a></div>
          <% } %>
          <h2 class="post-card-title"><a href="/article/<%= post.slug %>"><%= post.title %></a></h2>
          <p class="post-card-excerpt"><%= post.excerpt %></p>
          <div class="meta-line">
            <time datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
            <span>•</span>
            <span><%= post.reading_time %> min read</span>
          </div>
        </div>
      </article>
      <% }) %>
    </div>

    <%- include('../partials/sidebar') %>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
