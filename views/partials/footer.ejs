<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <div class="brand-logo" style="margin-bottom:0.75rem;">
          <img src="/logo.svg" alt="<%= settings.site_name || 'TechHavenUS' %>" class="brand-logo-img" width="180" height="44">
        </div>
        <p class="footer-desc">
          <%= settings.site_description || 'Independent technology news, AI analysis, GTA & PC gaming coverage, and developer tutorials.' %>
        </p>
        <div class="footer-publisher-meta">
          <div><strong><%= settings.publisher_legal_name || 'TechHaven US Media LLC' %></strong> (<%= settings.publisher_owner_name || 'Alex Mercer' %>)</div>
          <div><%= [settings.publisher_street_address, settings.publisher_city || 'New York', [settings.publisher_state || 'NY', settings.publisher_postal_code].filter(Boolean).join(' '), settings.publisher_country || 'United States'].filter(Boolean).join(', ') %></div>
          <div class="footer-emails">
            <span>Contact: <a href="mailto:<%= settings.contact_email || 'contact@techhavenus.com' %>"><%= settings.contact_email || 'contact@techhavenus.com' %></a></span>
            <span class="footer-email-sep" aria-hidden="true">•</span>
            <span>Editorial: <a href="mailto:editorial@techhavenus.com">editorial@techhavenus.com</a></span>
            <span class="footer-email-sep" aria-hidden="true">•</span>
            <span>Privacy: <a href="mailto:<%= settings.privacy_email || 'privacy@techhavenus.com' %>"><%= settings.privacy_email || 'privacy@techhavenus.com' %></a></span>
          </div>
        </div>
      </div>

      <div class="footer-nav-col">
        <h2 class="footer-title">Coverage Desks</h2>
        <ul class="footer-links">
          <% categories.slice(0, 6).forEach(function(cat) { %>
          <li><a href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
          <% }) %>
        </ul>
      </div>

      <div class="footer-nav-col">
        <h2 class="footer-title">Explore</h2>
        <ul class="footer-links">
          <li><a href="/briefing">Daily AI Briefing</a></li>
          <li><a href="/ai-tools">AI Tools Directory</a></li>
          <li><a href="/timelines">Tech News Timelines</a></li>
          <li><a href="/videos">Video Reviews &amp; Shorts</a></li>
          <li><a href="/my-feed">Personalized News Feed</a></li>
        </ul>
      </div>

      <div class="footer-legal-col">
        <h2 class="footer-title">Trust, SEO &amp; Legal</h2>
        <ul class="footer-links">
          <li><a href="/about">About &amp; Editorial Team</a></li>
          <li><a href="/editorial-policy">Editorial &amp; Fact-Check Policy</a></li>
          <li><a href="/contact">Contact &amp; News Tips</a></li>
          <li><a href="/privacy-policy">Privacy Policy (GDPR / CCPA)</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/disclaimer">Disclaimer</a></li>
          <li><a href="/sitemap.xml">XML Sitemap</a> • <a href="/ads.txt">ads.txt</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> <%= settings.site_name || 'TechHaven US' %> (<%= siteUrl %>). All rights reserved.</span>
      <span>Built for ultra-fast Core Web Vitals &amp; independent tech journalism.</span>
    </div>
  </div>
</footer>

<div id="cookieBanner" class="cookie-banner" role="dialog" aria-label="Cookie Consent">
  <div style="font-size:0.84rem;line-height:1.45;">
    <strong>Privacy &amp; Ad Preferences:</strong> We use essential cookies and privacy-safe measurement (GDPR/CCPA compliant) to keep TechHaven US fast and free via Google AdSense.
    <a href="/privacy-policy" style="color:#60a5fa;text-decoration:underline;">Read our Privacy Policy</a>
  </div>
  <div class="cookie-actions">
    <button type="button" id="cookieEssential" class="cookie-btn-ghost">Essential Only</button>
    <button type="button" id="cookieAccept" class="btn-primary">Accept All</button>
  </div>
</div>

<script src="/js/main.js?v=25" defer></script>
