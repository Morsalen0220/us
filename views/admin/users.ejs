<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Authors &amp; Roles — TechHaven CMS</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('./sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>Authors &amp; Editorial Roles</h1>
        <div style="font-size:0.88rem;color:#64748b;">Manage multi-author roles (Admin, Editor, Author) and E-E-A-T expertise profiles.</div>
      </div>
    </div>

    <% if (flash) { %><div class="alert alert-success"><%= flash %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="admin-split-side">
      <section class="card">
        <h2 style="margin:0 0 0.85rem;font-size:1.05rem;">Invite / Add Author</h2>
        <form action="/admin/users" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label>Full Name</label><input type="text" name="name" required></div>
          <div class="field"><label>Email</label><input type="email" name="email" required></div>
          <div class="field"><label>Password (min 8 chars)</label><input type="password" name="password" required minlength="8"></div>
          <div class="field">
            <label>Role</label>
            <select name="role">
              <option value="author">Author (submits In Review)</option>
              <option value="editor">Editor (can approve &amp; publish)</option>
              <option value="admin">Admin (full system access)</option>
            </select>
          </div>
          <div class="field"><label>Job Title</label><input type="text" name="job_title" placeholder="Senior AI Reporter"></div>
          <div class="field"><label>Expertise</label><input type="text" name="expertise" placeholder="AI Agents, EU Tech Policy"></div>
          <div class="field"><label>Location</label><input type="text" name="location" placeholder="New York, NY, USA"></div>
          <div class="field"><label>Credentials</label><input type="text" name="credentials" placeholder="M.S. CS • 7+ years reporting"></div>
          <div class="field"><label>LinkedIn URL</label><input type="url" name="linkedin_url" placeholder="https://linkedin.com/in/..."></div>
          <div class="field"><label>Short Bio</label><textarea name="bio" rows="2"></textarea></div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Create Editorial User</button>
        </form>
      </section>

      <section class="card">
        <h2 style="margin:0 0 0.85rem;font-size:1.05rem;">Team Directory (<%= users.length %>)</h2>
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Author</th><th>Role &amp; Expertise</th><th>Articles</th><th>Update Role</th></tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:0.65rem;">
                    <div style="width:40px;height:40px;border-radius:50%;overflow:hidden;background:linear-gradient(135deg,#2563eb,#0ea5e9);color:#fff;font-weight:800;display:grid;place-items:center;flex-shrink:0;">
                      <% if (u.avatar_url) { %>
                      <img src="<%= u.avatar_url %>" alt="<%= u.name %>" style="width:100%;height:100%;object-fit:cover;display:block;">
                      <% } else { %>
                      <%= u.name.slice(0, 1).toUpperCase() %>
                      <% } %>
                    </div>
                    <div>
                      <strong><%= u.name %></strong>
                      <div style="font-size:0.78rem;color:#64748b;"><%= u.email %></div>
                      <form action="/admin/users/<%= u.id %>/avatar?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data" style="display:flex;gap:0.3rem;align-items:center;margin-top:0.3rem;flex-wrap:wrap;">
                        <input type="file" name="avatar" accept="image/*" required style="font-size:0.72rem;max-width:150px;">
                        <button type="submit" class="btn btn-outline btn-sm" style="padding:0.18rem 0.45rem;font-size:0.72rem;">Set Photo</button>
                      </form>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge badge-webp"><%= u.role %></span>
                  <div style="font-size:0.78rem;color:#475569;"><%= u.job_title %> • <%= u.expertise %></div>
                </td>
                <td><%= u.post_count %></td>
                <td>
                  <details style="min-width:240px;">
                    <summary class="btn btn-outline btn-sm" style="cursor:pointer;list-style:none;">Edit Full Profile</summary>
                    <form action="/admin/users/<%= u.id %>/role" method="POST" style="margin-top:0.65rem;padding:0.75rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;display:grid;gap:0.45rem;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="admin-grid-2" style="gap:0.45rem;">
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Full Name</label><input type="text" name="name" value="<%= u.name %>" required style="padding:0.35rem 0.5rem;font-size:0.82rem;"></div>
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Email</label><input type="email" name="email" value="<%= u.email %>" required style="padding:0.35rem 0.5rem;font-size:0.82rem;"></div>
                      </div>
                      <div class="admin-grid-2" style="gap:0.45rem;">
                        <div class="field" style="margin:0;">
                          <label style="font-size:0.74rem;">Role</label>
                          <select name="role" style="padding:0.35rem 0.5rem;font-size:0.82rem;">
                            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                            <option value="editor" <%= u.role === 'editor' ? 'selected' : '' %>>editor</option>
                            <option value="author" <%= u.role === 'author' ? 'selected' : '' %>>author</option>
                          </select>
                        </div>
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Job Title</label><input type="text" name="job_title" value="<%= u.job_title || '' %>" style="padding:0.35rem 0.5rem;font-size:0.82rem;"></div>
                      </div>
                      <div class="admin-grid-2" style="gap:0.45rem;">
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Location</label><input type="text" name="location" value="<%= u.location || '' %>" placeholder="New York, NY, USA" style="padding:0.35rem 0.5rem;font-size:0.82rem;"></div>
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Credentials</label><input type="text" name="credentials" value="<%= u.credentials || '' %>" style="padding:0.35rem 0.5rem;font-size:0.82rem;"></div>
                      </div>
                      <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Expertise (comma-separated)</label><input type="text" name="expertise" value="<%= u.expertise || '' %>" style="padding:0.35rem 0.5rem;font-size:0.82rem;"></div>
                      <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Author Bio / Description</label><textarea name="bio" rows="3" style="padding:0.35rem 0.5rem;font-size:0.82rem;"><%= u.bio || '' %></textarea></div>
                      <div class="admin-grid-3" style="gap:0.4rem;">
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">X / Twitter</label><input type="text" name="twitter_handle" value="<%= u.twitter_handle || '' %>" style="padding:0.32rem 0.45rem;font-size:0.8rem;"></div>
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">LinkedIn URL</label><input type="url" name="linkedin_url" value="<%= u.linkedin_url || '' %>" style="padding:0.32rem 0.45rem;font-size:0.8rem;"></div>
                        <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Website URL</label><input type="url" name="website_url" value="<%= u.website_url || '' %>" style="padding:0.32rem 0.45rem;font-size:0.8rem;"></div>
                      </div>
                      <div class="field" style="margin:0;"><label style="font-size:0.74rem;">Reset Password (optional, min 8 chars)</label><input type="password" name="new_password" placeholder="Leave blank to keep current" style="padding:0.35rem 0.5rem;font-size:0.82rem;"></div>
                      <button type="submit" class="btn btn-primary btn-sm">Save Author Profile</button>
                    </form>
                  </details>
                  <% if (!currentUser || u.id !== currentUser.id) { %>
                  <form action="/admin/users/<%= u.id %>/delete" method="POST" style="margin-top:0.4rem;" onsubmit="return confirm('Delete this author profile? Any articles by them will be reassigned to your account.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger btn-sm">Delete Author</button>
                  </form>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
</div>
</body>
</html>
