<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>All Articles — TechHaven CMS</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('./sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>All Articles</h1>
        <div style="font-size:0.88rem;color:#64748b;">Manage posts, Google meta tags, and featured placements.</div>
      </div>
      <a href="/admin/posts/new" class="btn btn-primary">+ Write New Article</a>
    </div>

    <% if (flash === 'deleted') { %>
    <div class="alert alert-success">Article deleted cleanly and page cache cleared.</div>
    <% } %>

    <section class="card">
      <% const sc = (typeof statusCounts !== 'undefined' && statusCounts) ? statusCounts : { all: posts.length, published: 0, draft: 0, scheduled: 0, in_review: 0 }; %>
      <div class="status-tabs" aria-label="Filter articles by status">
        <a href="/admin/posts?status=all<%= filters.category !== 'all' ? '&category=' + filters.category : '' %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="status-tab <%= filters.status === 'all' ? 'active' : '' %>">All (<%= sc.all %>)</a>
        <a href="/admin/posts?status=published<%= filters.category !== 'all' ? '&category=' + filters.category : '' %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="status-tab <%= filters.status === 'published' ? 'active' : '' %>">Published (<%= sc.published %>)</a>
        <a href="/admin/posts?status=draft<%= filters.category !== 'all' ? '&category=' + filters.category : '' %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="status-tab <%= filters.status === 'draft' ? 'active' : '' %>">Drafts (<%= sc.draft %>)</a>
        <a href="/admin/posts?status=scheduled<%= filters.category !== 'all' ? '&category=' + filters.category : '' %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="status-tab <%= filters.status === 'scheduled' ? 'active' : '' %>">Scheduled (<%= sc.scheduled %>)</a>
        <a href="/admin/posts?status=in_review<%= filters.category !== 'all' ? '&category=' + filters.category : '' %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>" class="status-tab <%= filters.status === 'in_review' ? 'active' : '' %>">In Review (<%= sc.in_review %>)</a>
      </div>
      <form method="GET" action="/admin/posts" style="display:flex;flex-wrap:wrap;gap:0.65rem;margin-bottom:1rem;">
        <input type="text" name="q" value="<%= filters.q %>" placeholder="Search title, tag, or slug..." style="flex:1;min-width:200px;padding:0.5rem 0.75rem;border:1px solid #e2e8f0;border-radius:8px;">
        <select name="status" style="padding:0.5rem 0.75rem;border:1px solid #e2e8f0;border-radius:8px;">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
          <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
          <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
          <option value="in_review" <%= filters.status === 'in_review' ? 'selected' : '' %>>In Review</option>
          <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
        </select>
        <select name="category" style="padding:0.5rem 0.75rem;border:1px solid #e2e8f0;border-radius:8px;">
          <option value="all">All Categories</option>
          <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= String(filters.category) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-outline">Filter</button>
      </form>

      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Article</th>
              <th>Category</th>
              <th>Status</th>
              <th>SEO Tags</th>
              <th>Views</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (posts.length === 0) { %>
            <tr><td colspan="6" style="text-align:center;color:#64748b;padding:2rem;">No matching articles found.</td></tr>
            <% } %>
            <% posts.forEach(function(p) { %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:0.75rem;">
                  <% if (p.featured_image_thumb) { %>
                  <img src="<%= p.featured_image_thumb %>" alt="" style="width:68px;height:38px;object-fit:cover;border-radius:6px;flex-shrink:0;">
                  <% } %>
                  <div>
                    <div style="font-weight:700;"><%= p.title %></div>
                    <div style="font-size:0.78rem;color:#64748b;">/article/<%= p.slug %> • <%= p.word_count %> words</div>
                  </div>
                </div>
              </td>
              <td><%= p.category_name || '—' %><div style="font-size:0.75rem;color:#64748b;"><%= p.region || 'Global' %> • <%= p.author_name || '' %></div></td>
              <td>
                <span class="badge <%= p.status === 'published' ? 'badge-pub' : 'badge-draft' %>"><%= p.status %></span>
                <% if (p.is_featured) { %><span class="badge badge-webp">Featured</span><% } %>
                <% if (p.is_breaking) { %><span class="badge" style="background:#fee2e2;color:#991b1b;">Breaking</span><% } %>
                <% if (p.is_editors_pick) { %><span class="badge" style="background:#ede9fe;color:#5b21b6;">Pick</span><% } %>
              </td>
              <td>
                <% if (p.meta_title && p.meta_description) { %>
                <span style="color:#16a34a;font-weight:600;font-size:0.8rem;display:inline-flex;align-items:center;gap:0.25rem;"><%- icon('check', 14) %> Complete</span>
                <% } else { %>
                <span style="color:#d97706;font-weight:600;font-size:0.8rem;">Needs Meta</span>
                <% } %>
              </td>
              <td><%= p.views %></td>
              <td>
                <div style="display:flex;gap:0.4rem;">
                  <a href="/admin/posts/<%= p.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                  <% if (p.status === 'published') { %>
                  <a href="/article/<%= p.slug %>" target="_blank" class="btn btn-outline btn-sm">View</a>
                  <% } else { %>
                  <a href="/admin/posts/<%= p.id %>/preview" target="_blank" class="btn btn-outline btn-sm">Preview</a>
                  <% } %>
                  <form action="/admin/posts/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this article permanently?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>
</body>
</html>
