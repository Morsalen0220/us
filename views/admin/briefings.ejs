<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Daily Briefings Manager — TechHaven CMS</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('./sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <div><h1>Daily AI Briefings</h1></div>
      <a href="/briefing" target="_blank" class="btn btn-outline">View Public Briefings &rarr;</a>
    </div>

    <% if (flash) { %><div class="alert alert-success"><%= flash %></div><% } %>

    <div class="admin-split-side">
      <section class="card">
        <h2 style="margin:0 0 0.85rem;font-size:1.05rem;">Publish Daily Briefing</h2>
        <form action="/admin/briefings" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label>Briefing Date</label><input type="text" name="briefing_date" value="<%= new Date().toISOString().slice(0, 10) %>" required></div>
          <div class="field"><label>Title</label><input type="text" name="title" required placeholder="Daily AI & US/EU Tech Briefing"></div>
          <div class="field"><label>Summary</label><textarea name="summary" rows="2"></textarea></div>
          <div class="field">
            <label>Brief Items (1 per line: <code>Tag | Headline | Summary | /article/slug</code>)</label>
            <textarea name="items_text" rows="5" placeholder="AI Agents | OpenAI & Gemini Update | Short summary | /article/slug"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Save Briefing</button>
        </form>
      </section>

      <section class="card">
        <h2 style="margin:0 0 0.85rem;font-size:1.05rem;">Published Briefings (<%= briefings.length %>)</h2>
        <% briefings.forEach(function(b) { %>
        <div style="padding:0.75rem 0;border-bottom:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;gap:0.75rem;">
          <div>
            <strong><%= b.title %></strong>
            <div style="font-size:0.78rem;color:#64748b;"><%= b.briefing_date %> • <%= b.items.length %> items</div>
          </div>
          <form action="/admin/briefings/<%= b.id %>/delete" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
        <% }) %>
      </section>
    </div>
  </main>
</div>
</body>
</html>
